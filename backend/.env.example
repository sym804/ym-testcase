# ============================================================
# YM TestCase - 환경변수 설정
# 이 파일을 .env로 복사한 뒤 값을 수정하세요:
#   cp .env.example .env
# ============================================================

# ── 필수 설정 ──────────────────────────────────────────────

# JWT 서명 키 - 로그인 토큰 암호화에 사용
# 반드시 아래 값을 지우고 본인만의 랜덤 문자열로 교체하세요
# 예시: openssl rand -hex 32  또는 아무 긴 문자열
# 미설정 시 서버 재시작할 때마다 로그인이 풀립니다
SECRET_KEY=change-me-to-a-random-string

# ── 선택 설정 (기본값으로 동작, 필요할 때만 수정) ──────────

# 환경 모드: development 또는 production
# production으로 설정하면 SECRET_KEY 미설정 시 서버가 시작되지 않습니다
ENV=development

# 데이터베이스 URL (필수, PostgreSQL)
# 로컬: 레포 루트에서 docker compose up -d db 후 아래 값 그대로
# 배포: Supabase 트랜잭션 풀러 주소
DATABASE_URL=postgresql+psycopg2://ymtc:ymtc@127.0.0.1:54329/ymtc

# 마이그레이션 전용 주소 (배포: Supabase 직결 또는 세션 풀러). 비우면 DATABASE_URL
DATABASE_URL_DIRECT=

# 기동할 때 alembic upgrade head 를 할지 (서버리스는 0)
RUN_MIGRATIONS_ON_STARTUP=1

# null 이면 연결 풀 없이 동작 (서버리스)
DB_POOL=

# CORS 허용 오리진 (프론트엔드 주소, 쉼표로 여러 개 가능)
# 기본값 그대로면 로컬 개발에서 잘 동작합니다
# 예시: https://my-domain.com  (외부 배포 시 변경)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT 토큰 만료 시간 (시간 단위, 기본: 72시간 = 3일)
# 예시: 8  (8시간 유지하고 싶을 때)
TOKEN_EXPIRE_HOURS=72

# ── 파일 저장소 ────────────────────────────────────────────

# local(기본, 디스크) 또는 supabase(배포, 서버리스는 필수)
STORAGE_BACKEND=local
# local 일 때 저장 폴더. 비우면 backend/uploads
UPLOAD_DIR=
# supabase 일 때. 서비스 키는 서버 전용이며 프론트 빌드 변수에 넣지 않는다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=attachments

# ── 배포(서버리스) ─────────────────────────────────────────

# Vercel Cron 이 일일 정리(/api/internal/cron/daily)를 부를 때 쓰는 비밀값
CRON_SECRET=
# 기동할 때 일일 정리를 할지 (서버리스는 0, Cron 이 한다)
RUN_MAINTENANCE_ON_STARTUP=1
# 플랫폼이 덮어써서 위조할 수 없는 클라이언트 IP 헤더(예: x-real-ip). 비우면 소켓 주소
TRUSTED_PROXY_HEADER=
# 프로젝트 잠금 대기 상한(ms). 넘으면 409 로 다시 시도 안내
LOCK_WAIT_TIMEOUT_MS=10000

# ── 로그인 정책 ────────────────────────────────────────────────

# Google 로그인. 클라이언트 ID 가 비어 있으면 Google 로그인 버튼을 숨긴다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google 콘솔에 등록한 리디렉션 URI 와 글자까지 같아야 한다. 개발 환경은 비워 두면 아래 값을 쓴다
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# 회사 도메인(쉼표로 여러 개). Google Workspace 도메인으로 회사 계정을 판정한다
AUTH_COMPANY_DOMAINS=
# AUTH_COMPANY_DOMAINS=company.com

# 회사 도메인 밖 계정(개인 메일)을 받을지. 1 = 받는다, 0 = 회사 계정만
AUTH_ALLOW_PERSONAL=1
# AUTH_ALLOW_PERSONAL=0

# 관리자 승인이 필요한 대상. none = 모두 바로 사용(누구나 가입해 바로 씀),
# personal = 회사 Google 계정만 바로, 나머지는 승인 후, all = 모두 승인 후
AUTH_APPROVAL=none
# AUTH_APPROVAL=personal
# AUTH_APPROVAL=all

# 운영(ENV=production)의 빈 DB 에서 첫 관리자를 만들 때만 쓴다. 가입 화면에 이 값을 넣어야 한다
BOOTSTRAP_TOKEN=

# IP 하나가 1시간에 보낼 수 있는 가입 요청 수
REGISTER_MAX_PER_HOUR=10
